class Main {
    public static void main(String[] args) {
        int n = 3;
        int m = 3;
        
        int[][] arr = {
            {12, 5, 18},
            {7, 30, 4},
            {16, 8, 25}
        };
        
        int max=Integer.MIN_VALUE;
        for(int i=0;i<n;i++)
        {
            for(int j=0;j<m;j++)
            {
                if(max<arr[i][j])
                {
                    max=arr[i][j];
                }
                
            }
        }
        System.out.print(max);
}
}
