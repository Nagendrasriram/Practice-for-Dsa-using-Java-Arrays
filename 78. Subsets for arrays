Example 1:

Input: nums = [1,2,3]
Output: [[],[1],[2],[1,2],[3],[1,3],[2,3],[1,2,3]]
Example 2:

Input: nums = [0]
Output: [[],[0]]

import java.util.*;
class Solution {
    List<List<Integer>> ans = new ArrayList<>();
    public List<List<Integer>> subsets(int[] nums) {
        helper(0, nums, new ArrayList<>());
        return ans;
    }
    public void helper(int idx, int[] nums, List<Integer> curr)
    {
        if(idx==nums.length)
        {
            ans.add(new ArrayList<>(curr));
            return;
        }
        List<Integer> include = new ArrayList<>(curr);
        include.add(nums[idx]);
        helper(idx + 1, nums, include); // include
        helper(idx + 1, nums, curr);  

    } 
}
