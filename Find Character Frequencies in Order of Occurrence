class Main {
    public static void main(String[] args) {
        String sb ="Geeks for geeks";
        
        sb = sb.toLowerCase();
        int[] freq = new int[26];
        int n=sb.length();
        for(int i=0;i<n;i++)
        {
            if(sb.charAt(i)!=' '){
            freq[sb.charAt(i)-'a']++;
            }
        }
        for(int i=0;i<n;i++)
        {
            if(sb.charAt(i)!= ' '){
            if(freq[sb.charAt(i)-'a']!=0)
            {
                System.out.print(sb.charAt(i));
                System.out.print(freq[sb.charAt(i)-'a']+" ");
                freq[sb.charAt(i)-'a']=0;
                
            }
            }
        }
        }
        
    }
