Example 1:
Input:
 nums = [1, 2, 1, 1, 3, 2]  
Output:
 [1]  
Explanation:
 Here, n / 3 = 6 / 3 = 2.  
Therefore, the elements appearing 3 or more times are: [1].

Example 2:
Input:
 nums = [1, 2, 1, 1, 3, 2, 2]  
Output:
 [1, 2]  
Explanation:
 Here, n / 3 = 7 / 3 = 2.  
Therefore, the elements appearing 3 or more times are: [1, 2].

class Main {
    public static void main(String[] args) {
        int[] nums = {1, 2, 1, 1, 3, 2, 2}; 
        int el1=0,el2=0,cnt1=0,cnt2=0,n=nums.length;
        for(int i=0;i<n;i++)
        {
            if(cnt1==0 && el2!=nums[i])
            {
                cnt1=1;
                el1=nums[i];
            }
            else if(cnt2==0 && el1!=nums[i])
            {
                cnt2=1;
                el2=nums[i];
            }
            else if(el1==nums[i] )
            {
                cnt1++;
            }
            else if(el2==nums[i] )
            {
                cnt2++;
            }
            else
            {
                cnt1--;cnt2--;
            }
        }
        cnt1=0;
        cnt2=0;
        int mini = (n/3)+1;
        for(int i=0;i<n;i++)
        {
            if(el1==nums[i])
            {
                cnt1++;
            }
            if(el2==nums[i])
            {
                cnt2++;
            }
        }
        if(cnt1>=mini)
        {
            System.out.println(el1);
        }
        if(cnt2>=mini)
        {
            System.out.println(el2);
        }
        
        
    }
}
